{
  "contact": {
    "callerInformation": {
      "splitFormAt": 7
    },
    "childInformation": {
      "splitFormAt": 2
    },
    "caseInformation": {
      "splitFormAt": 2
    }
  },
  "case": {
    "sectionTypes": {
      "timesCoordination": {
        "splitFormAt": 5,
        "printOrder": 3,
        "caseHomeOrder": 3,
        "previewFields": [
          "callOutcome",
          "assistanceRequested"
        ],
        "layout": {
          "callOutcome": {
            "includeLabel": true
          },    
          "assistanceRequested": {
            "includeLabel": true
          }
        }
      },
      "assignedResponder": {
        "splitFormAt": 3,
        "printOrder": 2,
        "caseHomeOrder": 2,
        "previewFields": [
          "unitID",
          "unitFirstName",
          "unitLastName"
        ],
        "layout": {
          "unitID": {
            "includeLabel": true
          },
          "unitFirstName": {
            "includeLabel": true
          },          
          "unitLastName": {
            "includeLabel": true
          },
          "callReceivedTimestamp": {
            "format": "timestamp"
          },
          "dispatchedTimestamp": {
            "format": "timestamp"
          }, 
          "enrouteTimestamp": {
            "format": "timestamp"
          }, 
          "arrivedSceneTimestamp": {
            "format": "timestamp"
          },         
          "patientContactTimestamp": {
            "format": "timestamp"
          },         
          "departedSceneTimestamp": {
            "format": "timestamp"
          },         
          "arrivedHospitalTimestamp": {
            "format": "timestamp"
          },         
          "transferOfCareTimestamp": {
            "format": "timestamp"
          },         
          "departedHospitalTimestamp": {
            "format": "timestamp"
          },         
          "inServiceTimestamp": {
            "format": "timestamp"
          }        
        }
      },
      "incidentReport": {
        "splitFormAt": 10,
        "printOrder": 1,
        "caseHomeOrder": 1,
        "previewFields": [
          "incidentNumber",
          "incidentType"
        ],
        "layout": {
          "incidentCreationTimestamp": {
            "format": "timestamp"
          },  
          "incidentNumber": {
            "includeLabel": true
          },
          "incidentType": {
            "includeLabel": true
          }
        }
      },
      "patientCareReport": {
        "splitFormAt": 60,
        "printOrder": 4,
        "caseHomeOrder": 4,
        "previewFields": [
          "firstName",
          "lastName",
          "sex",
          "age"
        ],
        "layout": {
          "firstName": {
            "includeLabel": true
          },
          "lastName": {
            "includeLabel": true
          },
          "sex": {
            "includeLabel": true
          },
          "age": {
            "includeLabel": true
          },
          "medicalHistory": {
            "includeLabel": true
          },
          "allergies": {
            "includeLabel": true
          }
        }
      },
      "note": {
        "printOrder": 5,
        "caseHomeLocation": "timeline",
        "printFormat": "list"
      }
    }
  }
}
