{
  "task_routing": {
    "filters": [
      {
        "filter_friendly_name": "Direct Transfers",
        "expression": "transferTargetType =='worker' AND isContactlessTask != true",
        "targets": [
          {
            "queue": "${task_queues.eng_std}",
            "known_worker_sid": "task.targetSid",
            "expression": "worker.waitingOfflineContact != true",
            "priority": 150
          }
        ]
      },
      {
        "filter_friendly_name": "EN FCG SMS",
        "expression": "channelType =='chat' AND service=='fcg' AND serviceLanguage == 'english'",
        "targets": [
          {
            "queue": "${task_queues.en_fcg}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills      AND      'FCG' IN worker.routing.skills   )    AND    (      worker.roles HAS 'agent'  )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "skip_if": "1==1",
            "priority": 0
          },
          {
            "queue": "${task_queues.en_fcg}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills      AND      'FCG' IN worker.routing.skills   )    AND    (      worker.roles HAS 'agent'      AND     worker.roles HAS 'supervisor'   )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "priority": 0
          }
        ]
      },
      {
        "filter_friendly_name": "EN TYA SMS",
        "expression": "channelType =='chat' AND service=='tya' AND serviceLanguage == 'english'",
        "targets": [
          {
            "queue": "${task_queues.en_tya}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills      AND      'TYA' IN worker.routing.skills   )    AND    (      worker.roles HAS 'agent'   )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "skip_if": "1==1",
            "priority": 0
          },
          {
            "queue": "${task_queues.en_tya}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills      AND      'TYA' IN worker.routing.skills   )    AND    (      worker.roles HAS 'agent'      AND     worker.roles HAS 'supervisor'   )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "priority": 0
          }
        ]
      },
      {
        "filter_friendly_name": "EN STD SMS",
        "expression": "channelType =='chat' AND service=='std' AND serviceLanguage == 'english'",
        "targets": [
          {
            "queue": "${task_queues.en_std}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills    )    AND    (      worker.roles HAS 'agent'    )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "skip_if": "1==1",
            "priority": 0
          },
          {
            "queue": "${task_queues.en_std}",
            "expression": "(   worker.waitingOfflineContact != true   AND   (     (       task.channelType == 'voice'       AND       worker.channel.chat.assigned_tasks == 0     )     OR     (       task.channelType == 'chat'       AND       worker.channel.voice.assigned_tasks == 0     )   )   AND    (      'Calls' IN worker.routing.skills    )    AND    (      worker.roles HAS 'agent'      AND     worker.roles HAS 'supervisor'   )    AND   (     (       task.transferTargetType == 'worker'       AND       task.targetSid == worker.sid     )     OR     (       task.transferTargetType != 'worker'       AND       worker.sid != task.ignoreAgent     )   ) )",
            "priority": 0
          }
        ]
      },
      {
        "filter_friendly_name": "Offline Contacts",
        "expression": "isContactlessTask == true",
        "targets": [
          {
            "expression": "(task.targetSid == worker.sid AND task.isContactlessTask == true)",
            "queue": "${task_queues.en_std}"
          }
        ]
      },
      {
        "filter_friendly_name": "E2E Test",
        "expression": "channelType=='web' AND e2eTestMode=='true'",
        "targets": [
          {
            "expression": "(worker.waitingOfflineContact != true AND ((task.channelType == 'voice' AND worker.channel.chat.assigned_tasks == 0) OR (task.channelType != 'voice' AND worker.channel.voice.assigned_tasks == 0)) AND ((task.transferTargetType == 'worker' AND task.targetSid == worker.sid) OR (task.transferTargetType != 'worker' AND worker.sid != task.ignoreAgent))) OR (worker.waitingOfflineContact == true AND task.targetSid == worker.sid AND task.isContactlessTask == true)",
            "queue": "${task_queues.e2e_test}"
          }
        ]
      }
    ]
  }
}