
${
  jsonencode({
  "description": "${flow_description}",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "transitions": [
        {
          "event": "incomingMessage"
        },
        {
          "next": "run_subflow_system_down",
          "event": "incomingCall"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingRequest"
        },
        {
          "event": "incomingParent"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": -10
        }
      }
    },
    {
      "name": "send_to_queue",
      "type": "send-to-flex",
      "transitions": [
        {
          "event": "callComplete"
        },
        {
          "name": "webhook_notify_failed_to_enqueue",
          "event": "failedToEnqueue"
        },
        {
          "event": "callFailure"
        }
      ],
      "properties": {
        "offset": {
          "x": 80,
          "y": 460
        },
        "attributes": "${channel_attributes.default}",
        "workflow": "${workflow_sids.master}",
        "channel": "${task_channel_sids.voice}"
      }
    },
    {
      "name": "gather_message_welcome",
      "type": "gather-input-on-call",
      "transitions": [
        {
          "event": "keypress",
          "next": "recordVoicemail"
        },
        {
          "event": "speech"
        },
        {
          "event": "timeout",
          "next": "send_to_queue"
        }
      ],
      "properties": {
        "finish_on_key": "#",
        "gather_language": "${channel_flow_vars.voice_ivr_language}",
        "language": "en-US",
        "loop": 1,
        "offset": {
          "x": -12,
          "y": 178
        },
        "say": "${channel_flow_vars.voice_ivr_greeting_message}",
        "speech_model": "default",
        "speech_timeout": "5",
        "stop_gather": true,
        "timeout": 3
      }
    },
{
      "name": "recordVoicemail",
      "properties": {
        "finish_on_key": "#",
        "max_length": 3600,
        "offset": {
          "x": -386,
          "y": 423
        },
        "play_beep": "true",
        "timeout": 5
      },
      "transitions": [
        {
          "event": "recordingComplete",
          "next": "f_recordingCompleteCallback"
        },
        {
          "event": "noAudio"
        },
        {
          "event": "hangup",
          "next": "f_recordingCompleteCallback"
        }
      ],
      "type": "record-voicemail"
    },
    {
      "name": "f_recordingCompleteCallback",
      "properties": {
        "add_twilio_auth": false,
        "body": "{\"accountSid\":\"{\n  \"accountSid\": \"{{widgets.recordVoicemail.AccountSid}}\",\n  \"callSid\": \"{{widgets.recordVoicemail.CallSid}}\",\n  \"callStatus\": \"{{widgets.recordVoicemail.CallStatus}}\",\n  \"voicemailWorkflowSid\": \"${workflow_sids.master}\",\n  \"from\": \"{{trigger.call.From}}\",\n  \"maxCallbackAttempts\": 2,\n  \"routingAttributes\": \"{}\"}",
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "method": "POST",
        "offset": {
          "x": -269,
          "y": 627
        },
        "url": "https://hrm-staging.tl.techmatters.org/lambda/twilio/account-scoped/AC1ca120bc71593bbe9ca78e2232a31e0d/voicemail/recordingCompleteCallback"
      },
      "transitions": [
        {
          "event": "success"
        },
        {
          "event": "failed"
        }
      ],
      "type": "make-http-request"
    },
    {
      "name": "http_post_webhook_notify_failed_to_enqueue",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success"
        },
        {
          "event": "failed"
        }
      ],
      "properties": {
        "offset": {
          "x": 540,
          "y": 1250
        },
        "method": "POST",
        "content_type": "application/json;charset=utf-8",
        "body": "{ \"text\": \"Issue detected [Failed to Enqueue] on ${short_helpline} ${short_environment} Flow SID: {{flow.flow_sid}} Execution SID: {{flow.sid}}  \" }",
        "url": "${webhook_url_studio_errors}"
      }
    },
    {
      "name": "run_subflow_system_down",
      "type": "run-subflow",
      "transitions": [
        {
          "next": "gather_message_welcome",
          "event": "completed"
        },
        {
          "next": "gather_message_welcome",
          "event": "failed"
        }
      ],
      "properties": {
        "flow_sid": "${system_down_studio_subflow_sid}",
        "flow_revision": "LatestPublished",
        "offset": {
          "x": 110,
          "y": -270
        },
        "parameters": [
          {
            "type": "string",
            "value": "true",
            "key": "system_down"
          }
        ]
      }
    }
  ],
  "initial_state": "Trigger",
  "flags": {
    "allow_concurrent_calls": true
  }
})
}
