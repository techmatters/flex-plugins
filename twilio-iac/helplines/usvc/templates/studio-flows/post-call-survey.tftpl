          "name": "set_var_victim_service_profesional_yes",
          "type": "set-variables",
          "transitions": [
            {
              "next": "gather_input_voice_was_first_time",
              "event": "next"
            }
          ],
          "properties": {
            "variables": [
              {
                "type": "string",
                "value": "Yes",
                "key": "victim_service_profesional"
              }
            ],
            "offset": {
              "x": 0,
              "y": 5300
            }
          }
        },
        {
          "name": "set_var_victim_service_profesional_no",
          "type": "set-variables",
          "transitions": [
            {
              "next": "gather_input_voice_was_first_time",
              "event": "next"
            }
          ],
          "properties": {
            "variables": [
              {
                "type": "string",
                "value": "No",
                "key": "victim_service_profesional"
              }
            ],
            "offset": {
              "x": 400,
              "y": 5300
            }
          }
        },
        {
          "name": "gather_input_voice_was_first_time",
          "type": "gather-input-on-call",
          "transitions": [
            {
              "next": "split_was_first_time_response",
              "event": "keypress"
            },
            {
              "event": "speech"
            },
            {
              "next": "split_was_first_time_response",
              "event": "timeout"
            }
          ],
          "properties": {
            "play": "${flow_vars.post_survey_assets_url}/gather_input_voice_was_first_time.mp3",
            "number_of_digits": 1,
            "speech_timeout": "5",
            "offset": {
              "x": 0,
              "y": 5550
            },
            "loop": 1,
            "finish_on_key": "#",
            "stop_gather": true,
            "gather_language": "${flow_vars.gather_language}",
            "speech_model": "default",
            "timeout": 5
          }
        },
        {
          "name": "split_was_first_time_response",
          "type": "split-based-on",
          "transitions": [
            {
              "next": "set_var_was_first_time_unrecognized",
              "event": "noMatch"
            },
            {
              "next": "set_var_was_first_time_yes",
              "event": "match",
              "conditions": [
                {
                  "friendly_name": "If value equal_to 1",
                  "arguments": [
                    "{{widgets.gather_input_voice_was_first_time.Digits}}"
                  ],
                  "type": "equal_to",
                  "value": "1"
                }
              ]
            },
            {
              "next": "set_var_was_first_time_no",
              "event": "match",
              "conditions": [
                {
                  "friendly_name": "If value equal_to 2",
                  "arguments": [
                    "{{widgets.gather_input_voice_was_first_time.Digits}}"
                  ],
                  "type": "equal_to",
                  "value": "2"
                }
              ]
            }
          ],
          "properties": {
            "input": "{{widgets.gather_input_voice_was_first_time.Digits}}",
            "offset": {
              "x": 0,
              "y": 5770
            }
          }
        },
        {
          "name": "set_var_was_first_time_unrecognized",
          "type": "set-variables",
          "transitions": [
            {
              "next": "f_savePostSurvey",
              "event": "next"
            }
          ],
          "properties": {
            "variables": [
              {
                "type": "string",
                "value": "Unrecognized or no input",
                "key": "was_first_time"
              }
            ],
            "offset": {
              "x": -400,
              "y": 6000
            }
          }
        },
        {
          "name": "set_var_was_first_time_yes",
          "type": "set-variables",
          "transitions": [
            {
              "next": "f_savePostSurvey",
              "event": "next"
            }
          ],
          "properties": {
            "variables": [
              {
                "type": "string",
                "value": "Yes",
                "key": "was_first_time"
              }
            ],
            "offset": {
              "x": 0,
              "y": 6000
            }
          }
        },
        {
          "name": "set_var_was_first_time_no",
          "type": "set-variables",
          "transitions": [
            {
              "next": "f_savePostSurvey",
              "event": "next"
            }
          ],
          "properties": {
            "variables": [
              {
                "type": "string",
                "value": "No",
                "key": "was_first_time"
              }
            ],
            "offset": {
              "x": 400,
              "y": 6000
            }
          }
        },
        {
          "name": "f_savePostSurvey",
          "type": "make-http-request",
          "transitions": [
            {
              "next": "play_message_voice_post_survey_complete",
              "event": "success"
            },
            {
              "next": "play_message_voice_post_survey_complete",
              "event": "failed"
            }
          ],
          "properties": {
            "offset": {
              "x": 0,
              "y": 6250
            },
            "method": "POST",
            "content_type": "application/json;charset=utf-8",
            "add_twilio_auth": false,
            "body": "{\n  \"contactId\": \"{{trigger.call.contactId}}\",\n  \"contactTaskSid\": \"{{trigger.call.taskSid}}\",\n  \"postSurveyAnswers\": {\n    \"connected_to_vas\": \"{{flow.variables.connected_to_vas}}\",\n    \"specialist_knowledge_satisfaction\": \"{{flow.variables.specialist_knowledge_satisfaction}}\",\n    \"will_follow_advice\": \"{{flow.variables.will_follow_advice}}\",\n    \"would_recommend\": \"{{flow.variables.would_recommend}}\",\n    \"overall_satisfaction\": \"{{flow.variables.overall_satisfaction}}\",\n    \"self_or_other\": \"{{flow.variables.self_or_other}}\",\n    \"victim_service_profesional\": \"{{flow.variables.victim_service_profesional}}\",\n    \"was_first_time\": \"{{flow.variables.was_first_time}}\"\n  }\n}",
            "url": "${lambda_twilio_account_scoped_url}/hrm/savePostSurvey"
          }
        },
        {
          "name": "play_message_voice_post_survey_complete",
          "type": "say-play",
          "transitions": [
            {
              "event": "audioComplete"
            }
          ],
          "properties": {
            "play": "${flow_vars.post_survey_assets_url}/play_message_voice_post_survey_complete.mp3",
            "offset": {
              "x": 0,
              "y": 6500
            },
            "loop": 1
          }
        }
      ]
    }
  )
}
