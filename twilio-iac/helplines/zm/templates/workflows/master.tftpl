{
  "task_routing": {
    "filters": [
      {
        "filter_friendly_name": "Lifeline Counselors",
        "expression": "helpline == 'LifeLine Zambia (ZM)'",
        "targets": [
          {
            "queue": "${task_queues.lifeline}",
            "expression": "(worker.waitingForSpecificTask != true OR (task.targetSid == worker.sid AND task.waitingForSpecificTaskSid != null AND task.waitingForSpecificTaskSid == worker.waitingForSpecificTaskInfo.taskSid)) AND (worker.routing.skills HAS task.language AND ((task.transferTargetType == 'worker' AND task.targetSid == worker.sid) OR (task.transferTargetType != 'worker' AND worker.sid != task.ignoreAgent)) AND (worker.waitingOfflineContact != true OR worker.waitingForSpecificTask == true))",
            "skip_if": "1==1"
          },
          {
            "queue": "${task_queues.lifeline}",
            "expression": "(worker.waitingForSpecificTask != true OR (task.targetSid == worker.sid AND task.waitingForSpecificTaskSid != null AND task.waitingForSpecificTaskSid == worker.waitingForSpecificTaskInfo.taskSid)) AND (((task.transferTargetType == 'worker' AND task.targetSid == worker.sid) OR (task.transferTargetType != 'worker' AND worker.sid != task.ignoreAgent)) AND (worker.waitingOfflineContact != true OR worker.waitingForSpecificTask == true))"
          }
        ]
      },
      {
        "filter_friendly_name": "Childline Chat Language Counsellors",
        "expression": "helpline != 'LifeLine Zambia (ZM)'",
        "targets": [
          {
            "queue": "${task_queues.childline}",
            "expression": "(worker.waitingForSpecificTask != true OR (task.targetSid == worker.sid AND task.waitingForSpecificTaskSid != null AND task.waitingForSpecificTaskSid == worker.waitingForSpecificTaskInfo.taskSid)) AND (worker.routing.skills HAS task.language AND ((task.transferTargetType == 'worker' AND task.targetSid == worker.sid) OR (task.transferTargetType != 'worker' AND worker.sid != task.ignoreAgent)) AND (worker.waitingOfflineContact != true OR worker.waitingForSpecificTask == true))",
            "skip_if": "1 == 1"
          },
          {
            "queue": "${task_queues.childline}",
            "expression": "(worker.waitingForSpecificTask != true OR (task.targetSid == worker.sid AND task.waitingForSpecificTaskSid != null AND task.waitingForSpecificTaskSid == worker.waitingForSpecificTaskInfo.taskSid)) AND (((worker.waitingOfflineContact != true OR worker.waitingForSpecificTask == true) AND ((task.transferTargetType == 'worker' AND task.targetSid == worker.sid) OR (task.transferTargetType != 'worker' AND worker.sid != task.ignoreAgent))) OR (worker.waitingOfflineContact == true AND task.targetSid == worker.sid AND task.isContactlessTask == true))"
          }
        ]
      },
      {
        "filter_friendly_name": "Offline Contacts",
        "expression": "isContactlessTask == true",
        "targets": [
          {
            "expression": "(worker.waitingForSpecificTask != true OR (task.targetSid == worker.sid AND task.waitingForSpecificTaskSid != null AND task.waitingForSpecificTaskSid == worker.waitingForSpecificTaskInfo.taskSid)) AND ((task.targetSid == worker.sid AND task.isContactlessTask == true))",
            "queue": "${task_queues.childline}"
          }
        ]
      }
    ]
  }
}