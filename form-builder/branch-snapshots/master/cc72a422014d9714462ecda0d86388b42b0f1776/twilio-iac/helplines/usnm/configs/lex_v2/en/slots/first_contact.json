{
    "slotName": "first_contact",
    "slotTypeName": "yes_no",
    "intentName": "post_survey_yes",
    "description": "Slot first_contact for intent post_survey_yes",
    "valueElicitationSetting": {
        "slotConstraint": "Required",
        "promptSpecification": {
