        "description": "Example specific usch/configs/lex_v2/en_USCH/bots Pre Survey bot",
        "intents": [
          {
            "id": "i-7",
            "name": "pre_survey",
            "utterances": [
              "trigger_pre_survey",
              "Incoming webchat contact"
            ],
            "opening": "If this is a life-threatening emergency, please contact 911. To help us better serve you, please answer the next four short questions. You will then be connected to a counselor. You can type X if you prefer not to answer any question.",
            "closing": "Thank you, a counselor will be with you shortly.",
            "questions": [
              {
                "id": "q-2",
                "slot": "aboutSelf",
                "answerType": "yes_no",
                "question": "If you are texting about yourself press 1. If you are texting about someone else press 2.",
                "failureMessage": "We are having trouble understanding your response.",
                "retries": 1,
                "required": true,
                "file": "usch/configs/lex_v2/en_USCH/slots/aboutSelf.json",
                "shared": false
              },
              {
                "id": "q-3",
                "slot": "genderInput",
                "answerType": "genderInput",
                "question": "What is your gender identity?",
                "failureMessage": "We are having trouble understanding your response.",
