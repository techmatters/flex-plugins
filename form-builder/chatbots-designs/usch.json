              },
              {
                "id": "q-6",
                "slot": "howTheHelpseekerHeardAboutUs",
                "answerType": "howTheHelpseekerHeardAboutUs",
                "question": "How did you hear about this hotline? \n1. Internet/Website\n2. Google\n3. Chat GPT/AI\n4. Other",
                "failureMessage": "We are having trouble understanding your response.",
                "retries": 1,
                "required": true,
                "file": "usch/configs/lex_v2/en_USCH/slots/howTheHelpseekerHeardAboutUs.json",
                "shared": false
