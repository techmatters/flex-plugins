                "required": true,
                "file": "usch/configs/lex_v2/en_USCH/slots/genderInput.json",
                "shared": false
              },
              {
                "id": "q-4",
                "slot": "ageRange",
                "answerType": "ageRange",
                "question": "How old are you?",
                "failureMessage": "We are having trouble understanding your response.",
                "retries": 1,
                "required": true,
                "file": "usch/configs/lex_v2/en_USCH/slots/ageRange.json",
                "shared": false
              },
              {
                "id": "q-5",
                "slot": "stateInput",
                "answerType": "AMAZON.State",
                "question": "What state are you texting from?",
