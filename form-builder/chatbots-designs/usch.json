        "description": "Specific en_USCH/bots Post Survey bot",
        "intents": [
          {
            "id": "i-12",
            "name": "post_survey_yes",
            "utterances": [
              "Yes",
              "yes",
              "yeah",
              "1"
            ],
            "closing": "Thank you for contacting the hotline.  Feel free to reach out again if you need additional support.",
            "questions": [
